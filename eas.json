{
  "cli": {
    "version": ">= 20.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "dev-client": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging-api.apsraastro.com",
        "EXPO_PUBLIC_ASTRO_API_URL": "https://staging-api.apsraastro.com",
        "EXPO_PUBLIC_TRANSACTION_API_URL": "https://staging-api.apsraastro.com"
      },
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "development": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging-api.apsraastro.com",
        "EXPO_PUBLIC_ASTRO_API_URL": "https://staging-api.apsraastro.com",
        "EXPO_PUBLIC_TRANSACTION_API_URL": "https://staging-api.apsraastro.com"
      },
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "staging": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging-api.apsraastro.com",
        "EXPO_PUBLIC_ASTRO_API_URL": "https://staging-api.apsraastro.com",
        "EXPO_PUBLIC_TRANSACTION_API_URL": "https://staging-api.apsraastro.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging-api.apsraastro.com",
        "EXPO_PUBLIC_ASTRO_API_URL": "https://staging-api.apsraastro.com",
        "EXPO_PUBLIC_TRANSACTION_API_URL": "https://staging-api.apsraastro.com"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.apsraastro.com",
        "EXPO_PUBLIC_ASTRO_API_URL": "https://api.apsraastro.com",
        "EXPO_PUBLIC_TRANSACTION_API_URL": "https://api.apsraastro.com"
      },
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
